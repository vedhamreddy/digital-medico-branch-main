{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install website dependencies",
      "type": "shell",
      "command": "npm",
      "windows": { "command": "npm.cmd" },
      "args": ["ci"],
      "problemMatcher": []
    },
    {
      "label": "Start website",
      "type": "shell",
      "command": "npm",
      "windows": { "command": "npm.cmd" },
      "args": ["run", "dev"],
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Build website",
      "type": "shell",
      "command": "npm",
      "windows": { "command": "npm.cmd" },
      "args": ["run", "build"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Test backend",
      "type": "shell",
      "command": "npm",
      "windows": { "command": "npm.cmd" },
      "args": ["test"],
      "problemMatcher": []
    }
  ]
}
